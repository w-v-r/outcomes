{
  "name": "outcomes",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "predev": "npm run build:packages && npm run build:worker",
    "build": "next build",
    "prebuild": "npm run build:packages && npm run build:worker",
    "build:packages": "npm run build -w @outcomes/contracts && npm run build -w @outcomes/client && npm run build -w @outcomes/cli",
    "build:worker": "node scripts/build-isolated-worker.mjs",
    "clean:packages": "npm run clean -w @outcomes/contracts && npm run clean -w @outcomes/client && npm run clean -w @outcomes/cli",
    "smoke:cli-pack": "node scripts/smoke-cli-pack.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "pretest": "npm run build:packages && npm run build:worker",
    "test:watch": "vitest",
    "test:packages": "npm run build:packages && npm run test -w @outcomes/contracts && npm run test -w @outcomes/client && npm run test -w @outcomes/cli",
    "typecheck": "tsc --noEmit && npm run typecheck -w @outcomes/contracts && npm run typecheck -w @outcomes/client && npm run typecheck -w @outcomes/cli",
    "pretypecheck": "npm run build:packages",
    "cursor:repository:smoke": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/smoke-cursor-repository-access.ts",
    "github-app:worker:smoke": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/smoke-github-app-worker.ts",
    "tasks:reconcile": "node --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/reconcile-task-executions.ts",
    "pinch:webhook:configure": "node scripts/configure-pinch-webhook.mjs",
    "pinch:webhook:test": "node scripts/test-pinch-webhook.mjs",
    "payments:mock-worker": "node scripts/run-mock-worker-payment.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Predictable prices for agent work",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.24",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@outcomes/contracts": "1.0.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "mcp-handler": "^1.1.0",
    "next": "^16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "tar": "^7.5.22",
    "tsx": "^4.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
