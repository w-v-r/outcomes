NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

CURSOR_API_KEY=your-cursor-api-key
OUTCOMES_CURSOR_MODEL=composer-2.5
OUTCOMES_GITHUB_TOKEN=your-github-token-with-actions-access
OUTCOMES_GITHUB_APP_ID=123456
OUTCOMES_GITHUB_APP_CLIENT_ID=Iv1.your-client-id
OUTCOMES_GITHUB_APP_CLIENT_SECRET=your-github-app-client-secret
OUTCOMES_GITHUB_APP_SLUG=outcomes
OUTCOMES_GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# For local development, use a gitignored PEM path instead of the inline value.
# OUTCOMES_GITHUB_APP_PRIVATE_KEY_PATH=./outcomes-worker.private-key.pem
OUTCOMES_GITHUB_APP_STATE_SECRET=generate-at-least-32-random-bytes

PINCH_APPLICATION_ID=your-pinch-application-id
PINCH_APPLICATION_SECRET=your-pinch-application-secret
NEXT_PUBLIC_PINCH_PUBLISHABLE_KEY=your-pinch-test-publishable-key
PINCH_ENVIRONMENT=test
PINCH_API_VERSION=2020.1
PINCH_WEBHOOK_SECRET=whsec_your-pinch-webhook-secret
